{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=auth.db"
  },
  "Jwt": {
    "Issuer": "http://localhost:5080",
    "Audience": "auth-local-web",
    "AccessTokenMinutes": 15,
    "TwoFactorTokenMinutes": 5
  }
}
