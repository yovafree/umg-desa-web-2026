# Copia este archivo como .env y reemplaza los valores con los de TU tenant de Auth0.
# (El .env NO se versiona.) Ninguno de estos valores es secreto: una SPA no puede
# guardar secretos, por eso usa Authorization Code Flow + PKCE sin client secret.

# Dashboard > Applications > (tu SPA) > Settings > Domain
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
# Dashboard > Applications > (tu SPA) > Settings > Client ID
VITE_AUTH0_CLIENT_ID=tu-client-id
# Dashboard > Applications > APIs > (tu API) > Identifier
VITE_AUTH0_AUDIENCE=https://api.demo-auth.local

# URL base de Auth.Auth0.Api
VITE_API_URL=http://localhost:5080
