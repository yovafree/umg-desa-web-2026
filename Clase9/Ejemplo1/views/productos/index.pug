extends ../layout.pug

block content
  a(href="/productos/nuevo" class="inline-block mb-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700") + Nuevo producto

  table.w-full.border-collapse.bg-white.shadow.rounded.overflow-hidden
    thead.bg-gray-100
      tr
        th.text-left.px-4.py-2 ID
        th.text-left.px-4.py-2 Nombre
        th.text-left.px-4.py-2 Precio
        th.text-left.px-4.py-2 Stock
        th.text-left.px-4.py-2 Acciones
    tbody
      each producto in productos
        tr.border-t.border-gray-200
          td.px-4.py-2= producto.id
          td.px-4.py-2= producto.nombre
          td.px-4.py-2= producto.precio.toFixed(2)
          td.px-4.py-2= producto.stock
          td.px-4.py-2.space-x-2
            a(href=`/productos/${producto.id}` class="text-blue-600 hover:underline") Ver
            a(href=`/productos/${producto.id}/editar` class="text-blue-600 hover:underline") Editar
            form(action=`/productos/${producto.id}/eliminar` method="POST" class="inline")
              button(type="submit" class="text-red-600 hover:underline") Eliminar
