extends ../layout.pug

block content
  form.max-w-md.bg-white.shadow.rounded.p-6.space-y-4(action="/productos" method="POST")
    div
      label.block.font-semibold.mb-1(for="nombre") Nombre
      input.w-full.border.border-gray-300.rounded.px-3.py-2(type="text" id="nombre" name="nombre" required)

    div
      label.block.font-semibold.mb-1(for="precio") Precio
      input.w-full.border.border-gray-300.rounded.px-3.py-2(type="number" id="precio" name="precio" step="0.01" required)

    div
      label.block.font-semibold.mb-1(for="stock") Stock
      input.w-full.border.border-gray-300.rounded.px-3.py-2(type="number" id="stock" name="stock" required)

    button.px-4.py-2.bg-blue-600.text-white.rounded(type="submit" class="hover:bg-blue-700") Guardar

  a.inline-block.mt-4(href="/productos" class="text-blue-600 hover:underline") Cancelar
