extends ../layout.pug

block content
  ul.bg-white.shadow.rounded.p-6.space-y-2
    li
      strong.text-gray-900 ID:
      |  #{producto.id}
    li
      strong.text-gray-900 Nombre:
      |  #{producto.nombre}
    li
      strong.text-gray-900 Precio:
      |  Q#{producto.precio.toFixed(2)}
    li
      strong.text-gray-900 Stock:
      |  #{producto.stock}

  a.inline-block.mt-4(href="/productos" class="text-blue-600 hover:underline") Volver al listado
